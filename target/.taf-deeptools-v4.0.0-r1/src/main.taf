<taf-app:container:ghcr.io/taffish/deeptools:4.0.0-r1$@[docker/podman: $(taf_deeptools_check() { for taf_deeptools_member in genome.2bit resource.json SHA256SUMS READY; do test -f "$taf_deeptools_root/$taf_deeptools_member" && test ! -L "$taf_deeptools_root/$taf_deeptools_member" || return 1; done; for taf_deeptools_member in "$taf_deeptools_root"/* "$taf_deeptools_root"/.[!.\]* "$taf_deeptools_root"/..?*; do if test -e "$taf_deeptools_member" || test -L "$taf_deeptools_member"; then case "${taf_deeptools_member##*/}" in (genome.2bit|resource.json|SHA256SUMS|READY) :;; (*) return 1;; esac; fi; done; awk 'NF != 2 || length($1) != 64 || $1 ~ /[^a-f0-9\]/ { bad=1 } $2 == "genome.2bit" { g++ } $2 == "resource.json" { r++ } END { exit (bad || NR != 2 || g != 1 || r != 1) }' "$taf_deeptools_root/SHA256SUMS" || return 1; taf_deeptools_sum="$(taf_deeptools_hash "$taf_deeptools_root/SHA256SUMS")"; test "${taf_deeptools_sum%% *}" = "$(cat "$taf_deeptools_root/READY")" || return 1; grep -Fx '  "schema": "taffish.deeptools.resource.v1",' "$taf_deeptools_root/resource.json" >/dev/null || return 1; taf_deeptools_actual_id="$(sed -n 's/^  "resource": "\([A-Za-z0-9\][A-Za-z0-9_.-\]*\)",$/\1/p' "$taf_deeptools_root/resource.json")"; test -n "$taf_deeptools_actual_id" || return 1; case "$taf_deeptools_actual_id" in (*[!A-Za-z0-9_.-\]*) return 1;; esac; if test -z "${TAFFISH_DEEPTOOLS_RESOURCE_PATH:-}" && test "$taf_deeptools_actual_id" != "$taf_deeptools_id"; then printf >&2 'taf-deeptools: resource identity mismatch: requested=%s actual=%s\n' "$taf_deeptools_id" "$taf_deeptools_actual_id"; return 1; fi; taf_deeptools_expected_sha=''; case "$taf_deeptools_actual_id" in (ucsc-sacCer3-b061b22f) taf_deeptools_expected_sha=b061b22fdce3cb82c24d85101bc6eae98d23ea7194c1888c966b5446dd7909ab;; (ucsc-hg38-1f67aaa1) taf_deeptools_expected_sha=1f67aaa17a77b327738fe750ab37430a85dddf73c7d9189385ad1839259acec0;; (local-?*) :;; (*) return 1;; esac; if test -n "$taf_deeptools_expected_sha"; then grep -Fx "$taf_deeptools_expected_sha  genome.2bit" "$taf_deeptools_root/SHA256SUMS" >/dev/null || return 1; fi; (cd "$taf_deeptools_root" && if command -v sha256sum >/dev/null 2>&1; then sha256sum -c SHA256SUMS; else shasum -a 256 -c SHA256SUMS; fi) >/dev/null 2>&1; }; taf_deeptools_hash() { if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1"; else shasum -a 256 "$1"; fi; }; taf_deeptools_emit() { taf_deeptools_path="$(cd "$1" 2>/dev/null && pwd -P)"; taf_deeptools_bad="$(printf '%s' "$taf_deeptools_path" | tr -d 'A-Za-z0-9_./+-')"; if test -z "$taf_deeptools_path" || test -n "$taf_deeptools_bad"; then printf >&2 'taf-deeptools: resource bind path must use letters, digits, _, ., /, + or -; use a safe physical path\n'; printf -- '--taffish-deeptools-invalid-resource'; return; fi; printf -- '--volume=%s:%s' "$taf_deeptools_path" "$2"; }; if test -n "${TAFFISH_DEEPTOOLS_RESOURCE_INSTALL_ROOT:-}"; then taf_deeptools_emit "$TAFFISH_DEEPTOOLS_RESOURCE_INSTALL_ROOT" /resource-install; exit 0; fi; if test "${TAFFISH_DEEPTOOLS_RESOURCE_AUTO_MOUNT:-1}" = 0; then exit 0; fi; taf_deeptools_root="${TAFFISH_DEEPTOOLS_RESOURCE_PATH:-}"; taf_deeptools_id="${TAFFISH_DEEPTOOLS_RESOURCE_ID:-}"; if test -z "$taf_deeptools_root" && test -n "$taf_deeptools_id"; then taf_deeptools_bad="$(printf '%s' "$taf_deeptools_id" | tr -d 'A-Za-z0-9_.-')"; if test -n "$taf_deeptools_bad" || test "${taf_deeptools_id#.}" != "$taf_deeptools_id"; then printf -- '--taffish-deeptools-invalid-resource'; exit 0; fi; for taf_deeptools_candidate in "${TAFFISH_USER_HOME:-${HOME:-}/.local/share/taffish}/resources/deeptools/$taf_deeptools_id" "/usr/local/share/taffish/resources/deeptools/$taf_deeptools_id" "/opt/taffish/resources/deeptools/$taf_deeptools_id"; do if test -e "$taf_deeptools_candidate" || test -L "$taf_deeptools_candidate"; then taf_deeptools_root="$taf_deeptools_candidate"; break; fi; done; fi; if test -n "$taf_deeptools_root" || test -n "$taf_deeptools_id"; then if taf_deeptools_check; then taf_deeptools_emit "$taf_deeptools_root" /deeptools-resource:ro; else printf >&2 'taf-deeptools: selected resource missing or corrupt (identity/inventory/member check); run deeptools-resources verify or choose TAFFISH_DEEPTOOLS_RESOURCE_PATH\n'; printf -- '--taffish-deeptools-invalid-resource'; fi; fi)][docker: --user=$(id -u):$(id -g)][podman: --userns=keep-id --user=$(id -u):$(id -g)][apptainer: $(taf_deeptools_check() { for taf_deeptools_member in genome.2bit resource.json SHA256SUMS READY; do test -f "$taf_deeptools_root/$taf_deeptools_member" && test ! -L "$taf_deeptools_root/$taf_deeptools_member" || return 1; done; for taf_deeptools_member in "$taf_deeptools_root"/* "$taf_deeptools_root"/.[!.\]* "$taf_deeptools_root"/..?*; do if test -e "$taf_deeptools_member" || test -L "$taf_deeptools_member"; then case "${taf_deeptools_member##*/}" in (genome.2bit|resource.json|SHA256SUMS|READY) :;; (*) return 1;; esac; fi; done; awk 'NF != 2 || length($1) != 64 || $1 ~ /[^a-f0-9\]/ { bad=1 } $2 == "genome.2bit" { g++ } $2 == "resource.json" { r++ } END { exit (bad || NR != 2 || g != 1 || r != 1) }' "$taf_deeptools_root/SHA256SUMS" || return 1; taf_deeptools_sum="$(taf_deeptools_hash "$taf_deeptools_root/SHA256SUMS")"; test "${taf_deeptools_sum%% *}" = "$(cat "$taf_deeptools_root/READY")" || return 1; grep -Fx '  "schema": "taffish.deeptools.resource.v1",' "$taf_deeptools_root/resource.json" >/dev/null || return 1; taf_deeptools_actual_id="$(sed -n 's/^  "resource": "\([A-Za-z0-9\][A-Za-z0-9_.-\]*\)",$/\1/p' "$taf_deeptools_root/resource.json")"; test -n "$taf_deeptools_actual_id" || return 1; case "$taf_deeptools_actual_id" in (*[!A-Za-z0-9_.-\]*) return 1;; esac; if test -z "${TAFFISH_DEEPTOOLS_RESOURCE_PATH:-}" && test "$taf_deeptools_actual_id" != "$taf_deeptools_id"; then printf >&2 'taf-deeptools: resource identity mismatch: requested=%s actual=%s\n' "$taf_deeptools_id" "$taf_deeptools_actual_id"; return 1; fi; taf_deeptools_expected_sha=''; case "$taf_deeptools_actual_id" in (ucsc-sacCer3-b061b22f) taf_deeptools_expected_sha=b061b22fdce3cb82c24d85101bc6eae98d23ea7194c1888c966b5446dd7909ab;; (ucsc-hg38-1f67aaa1) taf_deeptools_expected_sha=1f67aaa17a77b327738fe750ab37430a85dddf73c7d9189385ad1839259acec0;; (local-?*) :;; (*) return 1;; esac; if test -n "$taf_deeptools_expected_sha"; then grep -Fx "$taf_deeptools_expected_sha  genome.2bit" "$taf_deeptools_root/SHA256SUMS" >/dev/null || return 1; fi; (cd "$taf_deeptools_root" && if command -v sha256sum >/dev/null 2>&1; then sha256sum -c SHA256SUMS; else shasum -a 256 -c SHA256SUMS; fi) >/dev/null 2>&1; }; taf_deeptools_hash() { if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1"; else shasum -a 256 "$1"; fi; }; taf_deeptools_emit() { taf_deeptools_path="$(cd "$1" 2>/dev/null && pwd -P)"; taf_deeptools_bad="$(printf '%s' "$taf_deeptools_path" | tr -d 'A-Za-z0-9_./+-')"; if test -z "$taf_deeptools_path" || test -n "$taf_deeptools_bad"; then printf >&2 'taf-deeptools: resource bind path must use letters, digits, _, ., /, + or -; use a safe physical path\n'; printf -- '--taffish-deeptools-invalid-resource'; return; fi; printf -- '--bind=%s:%s' "$taf_deeptools_path" "$2"; }; if test -n "${TAFFISH_DEEPTOOLS_RESOURCE_INSTALL_ROOT:-}"; then taf_deeptools_emit "$TAFFISH_DEEPTOOLS_RESOURCE_INSTALL_ROOT" /resource-install; exit 0; fi; if test "${TAFFISH_DEEPTOOLS_RESOURCE_AUTO_MOUNT:-1}" = 0; then exit 0; fi; taf_deeptools_root="${TAFFISH_DEEPTOOLS_RESOURCE_PATH:-}"; taf_deeptools_id="${TAFFISH_DEEPTOOLS_RESOURCE_ID:-}"; if test -z "$taf_deeptools_root" && test -n "$taf_deeptools_id"; then taf_deeptools_bad="$(printf '%s' "$taf_deeptools_id" | tr -d 'A-Za-z0-9_.-')"; if test -n "$taf_deeptools_bad" || test "${taf_deeptools_id#.}" != "$taf_deeptools_id"; then printf -- '--taffish-deeptools-invalid-resource'; exit 0; fi; for taf_deeptools_candidate in "${TAFFISH_USER_HOME:-${HOME:-}/.local/share/taffish}/resources/deeptools/$taf_deeptools_id" "/usr/local/share/taffish/resources/deeptoo